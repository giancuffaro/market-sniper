__pycache__/
*.pyc
data/

# Your saved setup — API keys live in here. Never leaves your computer.
# auto_sync.py refuses to stage this file even if this line were removed.
my-settings.json

# All logs live in logs/ now. auto_sync sweeps stray ones off the root.
logs/
*.log
*.log.*

# Retired one-time files, kept locally as a safety copy. Not part of the app.
_archive/

# One-shot throwaway that deletes itself after a successful start.
*CLEAN RESTART*.bat

# Files parked for deletion. The launcher removes this folder on start.
_trash/
